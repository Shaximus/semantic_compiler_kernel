+    """Look a concept up by tolerant name, following legacy aliases. Never raises."""
+    key = normalize_concept_name(name)
+    key = ONTOLOGY_ALIASES.get(key, key)
+    return MEDICAL_ONTOLOGY.get(key)
+
 
 def get_concept(name: str) -> MedicalConcept:
-    return MEDICAL_ONTOLOGY[name]
+    """Return the concept for ``name`` (tolerant of case/spacing and legacy aliases).
+
+    Raises ``KeyError`` for names that are not in the ontology.
+    """
+    concept = resolve_concept(name)
+    if concept is None:
+        raise KeyError(name)
+    return concept
 
 
 def is_valid_medical_map(name: str) -> bool:
+    """True only for exact canonical keys (aliases and role tags are not canonical)."""
     return name in MEDICAL_ONTOLOGY
+
+
+def classify_medical_map(name: str) -> str:
+    """Classify a ``medical_map`` value: ontology | alias | functional_role | unknown."""
+    if name in MEDICAL_ONTOLOGY:
+        return "ontology"
+    key = normalize_concept_name(name)
+    if key in MEDICAL_ONTOLOGY:
+        return "ontology"
+    if key in ONTOLOGY_ALIASES:
+        return "alias"
+    if key in FUNCTIONAL_ROLE_TAGS:
+        return "functional_role"
+    return "unknown"
