+def lambert_w0(x: float, *, tolerance: float = 1e-13, max_iterations: int = 64) -> float:
+    """
+    Principal branch W0 of the Lambert W function (the solution w of w·e^w = x).
+
+    Real for x >= -1/e. Solved by Halley iteration from a branch-point series or
+    the asymptotic ln x - ln ln x start, so it is accurate for arguments from
+    -1/e to ~1e300. The asymptotic form alone, which this module used before, is
+    off by 0.05 at x = 1e38 and badly wrong below x = e.
+    """
+    x = _finite(x, "x")
+    branch_point = -1.0 / math.e
+    if x < branch_point:
+        raise ValueError(f"lambert_w0 is real only for x >= -1/e, got {x!r}")
+    if x == 0.0:
+        return 0.0
+    if x == branch_point:
+        return -1.0
+
+    if x < -0.25:
+        p = math.sqrt(2.0 * (math.e * x + 1.0))
+        w = -1.0 + p - p * p / 3.0 + 11.0 * p**3 / 72.0
+    elif x < 3.0:
+        w = math.log1p(x)
+    else:
+        log_x = math.log(x)
+        w = log_x - math.log(log_x)
+
+    for _ in range(max_iterations):
+        exp_w = math.exp(w)
+        residual = w * exp_w - x
+        denominator = exp_w * (w + 1.0) - (w + 2.0) * residual / (2.0 * w + 2.0)
+        step = residual / denominator
+        w -= step
+        if abs(step) <= tolerance * max(1.0, abs(w)):
+            return w
+    raise ArithmeticError(f"lambert_w0 did not converge for x={x!r}")
