index 0000000..7ef8926
--- /dev/null
+++ b/expansion/templates/networking.yaml
@@ -0,0 +1,136 @@
+domain: networking
+version: 1.0
+description: >-
+  Internet-scale networked systems: the four invariants (interface, coordination, state, time),
+  the RFC 1958 architectural principles, RPKI-secured routing authorization and DNSSEC-secured
+  naming. Invariants carry source tags defined in docs/DEEP_SYSTEM_INVARIANTS.md; failure modes
+  and patterns are template-author mappings.
+components:
+  - name: end_host
+    function: implements reliability, security and application semantics at the fringes of the network
+    criticality: high
+    medical_map: homeostasis
+  - name: forwarding_plane
+    function: moves datagrams efficiently and flexibly while holding as little state as possible
+    criticality: high
+  - name: routing_control_plane
+    function: distributes reachability and chooses paths between autonomous systems
+    criticality: high
+  - name: naming_system
+    function: maps names to data and addresses
+    criticality: high
+  - name: resource_registry_hierarchy
+    function: allocates IP addresses and AS numbers from IANA through RIRs, NIRs and LIRs
+    criticality: medium
+  - name: resource_pki
+    function: resource certificates bind keys to IP and AS resources and attest allocation, not identity
+    criticality: high
+    medical_map: immune_system
+  - name: route_origin_authorization
+    function: signed statement that one AS may originate routes to given prefixes
+    criticality: medium
+    medical_map: vaccination
+  - name: signed_zone_chain
+    function: signed zones whose delegation-signer records link each child back to a trust anchor
+    criticality: high
+    medical_map: immune_system
+  - name: validating_resolver
+    function: validates answers and reports Secure, Insecure, Bogus or Indeterminate
+    criticality: high
+    medical_map: diagnosis
+  - name: untrusted_repository
+    function: publishes signed objects and manifests over a channel that nobody has to trust
+    criticality: low
+relationships:
+  - from: end_host
+    to: forwarding_plane
+    type: sends_datagrams_through
+  - from: routing_control_plane
+    to: forwarding_plane
+    type: programs
+  - from: resource_registry_hierarchy
+    to: resource_pki
+    type: mirrored_by
+  - from: resource_pki
+    to: route_origin_authorization
+    type: signs
+  - from: route_origin_authorization
+    to: routing_control_plane
+    type: authorizes_origins_in
+  - from: untrusted_repository
+    to: resource_pki
+    type: distributes_objects_of
+  - from: naming_system
+    to: signed_zone_chain
+    type: secured_by
+  - from: signed_zone_chain
+    to: validating_resolver
+    type: validated_by
+  - from: validating_resolver
+    to: end_host
+    type: answers
+invariants:
+  - "every networked system has four invariants to reason about: interface, coordination, state and time [UCSB-176C]"
+  - "intelligence is end to end rather than hidden in the network: functions that depend on the endpoints belong in the endpoints and everything else is done at the fringes [RFC1958]"
+  - "state held inside the network must be minimized and manually configured state kept to an absolute minimum [RFC1958]"
+  - "nobody owns the network, there is no centralized control, and transmission failures at some statistical rate are expected rather than prevented [RFC1958]"
+  - "be strict when sending and tolerant when receiving [RFC1958]"
+  - "designs must scale to very many nodes per site and to many millions of sites, keep it simple, and keep modules separate where possible [RFC1958]"
+  - "the internet-level protocol is independent of the hardware medium and hardware addressing [RFC1958]"
+  - "resource certificates bind public keys to IP address and AS number resources and attest allocation, so the PKI provides authorization and not identity [RFC6480]"
+  - "the certificate hierarchy mirrors the allocation hierarchy, rooted at IANA and descending through the RIRs, NIRs and LIRs or ISPs [RFC6480]"
+  - "a route origination authorization names a single AS that may originate routes to one or more prefixes, and each end-entity key signs exactly one object so revoking its certificate revokes that object [RFC6480]"
+  - "the repository is untrusted: signatures make tampering detectable and manifests list object hashes so relying parties detect deletion or stale replacement [RFC6480]"
+  - "a holder revokes an authorization only after a valid replacement exists (make before break) [RFC6480]"
+  - "DNSSEC adds data-origin authentication, data integrity and authenticated denial of existence to the DNS [RFC4033]"
+  - "validation follows a chain from a configured trust anchor, DNSKEY to DS to DNSKEY to RRset, and DS records let a parent vouch for a child's keys [RFC4033]"
+  - "a validator reports exactly one of Secure, Insecure, Bogus or Indeterminate, and Bogus means the data failed validation, for example through missing or expired signatures [RFC4033]"
+  - "DNSSEC provides no confidentiality and no protection against denial of service, and it opens a new class of denial-of-service attacks [RFC4033]"
+failure_modes:
+  - name: route_origin_hijack
+    medical_map: pathogen
+    description: an AS originates a prefix it was never authorized to originate and attracts traffic
+    indicators: [unexpected_origin_as, prefix_without_authorization, more_specific_prefix_announced]
+  - name: bogus_dns_data_accepted
+    medical_map: pathogen
+    description: forged or altered naming data is trusted because validation is absent or bypassed
+    indicators: [unsigned_answer_trusted, missing_trust_anchor, validation_disabled]
+  - name: validity_window_lapse
+    medical_map: acute
+    description: signatures or manifests expire and validators suddenly start rejecting valid data as Bogus
+    indicators: [expired_signature, stale_manifest, bogus_validation_spike]
+  - name: self_inflicted_validation_failure
+    medical_map: autoimmune
+    description: a correct zone or repository is rejected by its own relying parties after a rollover or provisioning mistake
+    indicators: [ds_dnskey_mismatch, break_before_make_rollover, authorization_revoked_without_replacement]
+  - name: routing_instability_cascade
+    medical_map: sepsis
+    description: a local routing fault propagates across autonomous systems into wide reachability loss
+    indicators: [route_flap_storm, withdrawal_cascade, reachability_loss_across_as_boundaries]
+  - name: validation_amplified_overload
+    medical_map: inflammation
+    description: signing and validation work create new load that a flood can exploit
+    indicators: [validator_cpu_saturation, large_signed_responses, resolver_timeouts]
+  - name: core_state_accumulation
+    medical_map: chronic
+    description: per-flow or hand-configured state accumulates in the core and slows recovery
+    indicators: [growing_core_state, manual_configuration_drift, slow_failover]
+architecture_patterns:
+  - name: end_to_end_principle
+    medical_map: homeostasis
+    description: regulation lives at the endpoints and the core stays simple
+  - name: layered_modularity
+    medical_map: quarantine
+    description: independent layers keep failure domains separate
+  - name: signed_delegation_hierarchy
+    medical_map: immune_system
+    description: authority is delegated down a hierarchy that mirrors allocation, each step signed
+  - name: pre_authorized_origins
+    medical_map: vaccination
+    description: origin authorizations are published before an attack so invalid announcements can be recognised
+  - name: make_before_break_rollover
+    medical_map: physiotherapy
+    description: a replacement is validated and in use before the old object is withdrawn
+  - name: authenticated_denial_of_existence
+    medical_map: diagnosis
+    description: absence of a name or type is itself provable with the same signature checks
